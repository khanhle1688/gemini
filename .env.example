# Cổng chạy ứng dụng
PORT=3000

# Khóa bí mật JWT để mã hóa phiên đăng nhập
JWT_SECRET=gemini-video-20s-secret-key-change-this-in-production

# Khóa Google Gemini API (Tùy chọn - nếu muốn dùng API thay vì bộ não nội bộ)
GEMINI_API_KEY=

# Đường dẫn gọi FFmpeg (Nếu để trống hệ thống sẽ tự động tìm)
FFMPEG_PATH=
