# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Môi trường bí mật
.env
.env.local

# Dữ liệu runtime & video tạm
server/storage/temp/*
server/storage/videos/*.mp4
server/storage/videos/*.jpg
!server/storage/videos/.gitkeep
!server/storage/temp/.gitkeep

# Dữ liệu database cục bộ
server/data/*.json
!server/data/.gitkeep

# Hệ điều hành
.DS_Store
Thumbs.db
